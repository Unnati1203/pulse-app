{"name":"pulse-email-platform","private":true,"version":"1.0.0","scripts":{"dev":"concurrently -k \"npm:dev:server\" \"npm:dev:web\"","dev:server":"tsx watch server/src/index.ts","dev:web":"vite web --config web/vite.config.ts --configLoader runner --host 0.0.0.0","build":"npm run build:server && npm run build:web","build:server":"tsc -p server/tsconfig.json","build:web":"vite build web --config web/vite.config.ts --configLoader runner", "preview":"vite preview web --config web/vite.config.ts --configLoader runner --host 0.0.0.0","typecheck":"tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit","db:generate":"prisma generate --schema server/prisma/schema.prisma","db:migrate":"prisma migrate dev --schema server/prisma/schema.prisma","start":"node server/dist/index.js"},"workspaces":["server","web"],"devDependencies":{"concurrently":"^9.1.2","prisma":"^6.5.0","tsx":"^4.19.3","typescript":"^5.8.2","vite":"^6.2.2"},"dependencies":{"@prisma/client":"^6.19.3"}}